{
  "name": "chent-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "node scripts/generate-content-index.mjs && node node_modules/@rsbuild/core/bin/rsbuild.js dev",
    "build": "tsc --noEmit && node scripts/generate-content-index.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-rss.mjs && node node_modules/@rsbuild/core/bin/rsbuild.js build && node scripts/post-build.mjs",
    "preview": "node node_modules/@rsbuild/core/bin/rsbuild.js preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.{mjs,js}\" \"*.{json,ts,mjs}\"",
    "detect:friends": "node scripts/detect-friends.mjs",
    "generate:covers": "node scripts/generate-article-covers.mjs",
    "generate:content-index": "node scripts/generate-content-index.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:rss": "node scripts/generate-rss.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "abcjs": "^6.4.4",
    "buffer": "^6.0.3",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "katex": "^0.16.21",
    "lucide-react": "^1.16.0",
    "mermaid": "^11.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^3.1.2",
    "wouter": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rsbuild/core": "^1.2.14",
    "@rsbuild/plugin-react": "^1.1.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0"
  }
}